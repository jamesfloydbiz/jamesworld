# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/worktrees/
.claude/launch.json

# Local backup of pre-normalization Sonder letter PNGs — not needed in deploy
public/sonder/_letter_originals/
public/sonder/.png_originals/

# Environment files (contain Supabase keys — keep out of the public repo)
.env
.env.*
!.env.example

# Audio-gen cache metadata (regenerated locally by scripts/gen-audio.mjs)
public/audio/*.sha1

# iCloud sync conflict copies: "name 2.html", "name 3.js". One digit after a
# space, scoped to the extensions the site actually builds — a broader
# "* [0-9].*" would swallow real files whose names end in a number, like
# "Ep. 082.jpeg" and "Poem 088 - Tomorrow I turn 24.pdf".
*\ [0-9].js
*\ [0-9].mjs
*\ [0-9].html
*\ [0-9].css
*\ [0-9].json
*\ [0-9].svg
*\ [0-9].jpg
*\ [0-9].jpeg
*\ [0-9].png
*\ [0-9].webp
*\ [0-9].mp4
