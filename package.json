{
  "name": "jamesfloyds-world",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "jamesfloyds.world \u2014 plain HTML site, no framework.",
  "scripts": {
    "fetch:substack": "bun scripts/fetch-substack.mjs",
    "bake:linkedin": "bun scripts/bake-linkedin.mjs",
    "bake:rabbit-holes": "bun scripts/bake-rabbit-holes.mjs",
    "poems:scans": "python3 scripts/prepare-poem-scans.py",
    "bake:poems": "bun scripts/bake-poems.mjs",
    "build:site": "bun scripts/fetch-substack.mjs && bun scripts/bake-linkedin.mjs && bun scripts/bake-rabbit-holes.mjs && bun scripts/bake-poems.mjs && bun scripts/build-site.mjs",
    "serve:site": "bun scripts/serve-site.mjs",
    "vault": "bun scripts/build-vault.mjs",
    "vault:graph": "bun scripts/build-vault-graph.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "kokoro-js": "^1.2.1",
    "onnxruntime-common": "1.21.0"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs"
  ]
}
